# provenance: flext-ldif FlextLdif().migration_pipeline oid->oud base_dn=dc=ctbc output of acl_synth_input.ldif (sha256=91e103d8bf5cac49243692ed2e0312bc1215d25e97cc339cf6450537e51be1e0); flext-ws7iv semantics: union of grants minus denials per ACI (OID-30 30.1.6.2), denials rendered as OUD deny (OUD 9.1.4); regenerate on any intended conversion change
version: 1

dn: cn=admins,dc=ctbc
changetype: modify
replace: aci
aci: (targetattr="*")
     (version 3.0; acl "admins Entry by SecurityAdmins";
      deny (read, search, add, delete, proxy)    userdn="ldap:///anyone";)
-

dn: cn=groupattr-case,dc=ctbc
changetype: modify
replace: aci
aci: (targetattr="member")
     (version 3.0; acl "groupattr-case Attrs by uniquemember";
      deny (read, search, write, selfwrite, compare)    userdn="ldap:///anyone";)
-

dn: cn=negated-wildcard,dc=ctbc
changetype: modify
replace: aci
aci: (targetattr="orclpasswordhint")
     (version 3.0; acl "negated-wildcard Attrs by CommonUsers";
      allow (search)                 groupdn="ldap:///cn=CommonUsers,dc=ctbc";
      deny (read, write, compare)    userdn="ldap:///anyone";)
-

dn: cn=owner-groups,dc=ctbc
changetype: modify
replace: aci
aci: (targetattr="*")
     (targetscope="base")
     (version 3.0; acl "owner-groups Entry by owner";
      deny (read, search, delete, proxy)    userdn="ldap:///anyone";)
aci: (targetattr="*")
     (targetscope="onelevel")
     (version 3.0; acl "owner-groups Entry by owner";
      deny (add)    userdn="ldap:///anyone";)
aci: (targetattr="uniquemember")
     (targetscope="base")
     (version 3.0; acl "owner-groups Attrs by owner";
      deny (read, search, write, selfwrite, compare)    userdn="ldap:///anyone";)
-

dn: cn=public-read,dc=ctbc
changetype: modify
replace: aci
aci: (targetattr="cn||sn||mail")
     (targetscope="base")
     (version 3.0; acl "public-read Attrs by anyone";
      allow (read, search, compare)    userdn="ldap:///anyone";)
-

dn: cn=superuser-case,dc=ctbc
changetype: modify
replace: aci
aci: (targetattr="*")
     (version 3.0; acl "superuser-case Attrs by Directory Manager";
      deny (read, search, write, selfwrite, compare)    userdn="ldap:///anyone";)
-

dn: cn=users-attrs,dc=ctbc
changetype: modify
replace: aci
aci: (targetattr="userPassword")
     (targetfilter="(objectclass=inetorgperson)")
     (version 3.0; acl "users-attrs Attrs by SecurityAdmins";
      deny (read, search, write, selfwrite, compare)    userdn="ldap:///anyone";)
-

